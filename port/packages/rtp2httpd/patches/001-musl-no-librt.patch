---
 CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8818990..5e57baf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -156,8 +156,8 @@ find_package(Threads REQUIRED)
 # Math functions require libm on some Unix platforms; macOS maps it to libSystem.
 target_link_libraries(rtp2httpd PRIVATE Threads::Threads m)
 
-if(PLATFORM_LINUX)
-  # rt library for clock_gettime (not needed on macOS)
+option(LINK_RT "Link librt for clock_gettime" ON)
+if(LINK_RT)
   target_link_libraries(rtp2httpd PRIVATE rt)
 endif()
 

# Official A53 package installation: trust and target-only runtime libraries.
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y

# Build legacy LuCI support against the same ucode as the firmware.
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_ucode-mod-lua=y

# VPN dependencies; the applications remain available from official feeds.
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-ovpn-backports=y

# SQM and traffic accounting.
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-connmark=y
CONFIG_PACKAGE_kmod-sched-ctinfo=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-inet-diag=y

# Transparent proxy and multi-WAN rules for nftables and iptables consumers.
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-nat6=y

# ──────────────────────────────────────────────────────────────────────────────
# TYFZA1 PonWRT feature packages (pre-installed into firmware)
# ──────────────────────────────────────────────────────────────────────────────

# HomeProxy (immortalwrt/homeproxy, sing-box backend)
# Dependencies: sing-box (pulled via luci-app-homeproxy DEPENDS),
# firewall4, kmod-nft-tproxy, ucode-mod-digest
# NOTE: do NOT force-select sing-box here — sing-box/sing-box-tiny share
# a PROVIDES/CONFLICTS pair that creates a recursive Kconfig dependency
# when the full variant is selected together with luci-app-homeproxy's
# +sing-box dep (which resolves to tiny).
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_ucode-mod-digest=y

# frpc (official feeds: frp + luci-app-frpc)
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y

# FileBrowser (prebuilt arm64 binary v2.43.0)
CONFIG_PACKAGE_filebrowser=y
CONFIG_PACKAGE_luci-app-filebrowser=y

# rtp2httpd (IP multicast to HTTP, TYFZA1 IPTV delivery)
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y

# Syncthing (official feed + luci-app-syncthing)
CONFIG_PACKAGE_syncthing=y
CONFIG_PACKAGE_luci-app-syncthing=y

# Samba4 (official feed + luci-app-samba4)
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y

# EasyTier (mesh VPN, prebuilt aarch64 binary v2.7.0)
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# luci-app-mesh (xxosdev/luci-app-mesh, IEEE 802.11s / batman-adv mesh)
# wpad-mbedtls (full, CONFIG_MESH=y) already selected in boot config.
# These are from the official packages/luci feeds.
CONFIG_PACKAGE_luci-app-mesh=y
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_PACKAGE_batctl-default=y
CONFIG_PACKAGE_luci-proto-batman-adv=y
CONFIG_PACKAGE_dawn=y
# CONFIG_PACKAGE_umdns is not set — umdns is absent from the pinned
# openwrt tree (79bc56cb) and packages feed (db09fc6e); dawn's
# neighbour discovery falls back to its built-in mechanism.